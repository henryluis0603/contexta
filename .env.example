# Copia este archivo como .env y completa tus valores. NUNCA subas el .env real.
OPENAI_API_KEY=
# Modelo de chat (debe soportar salidas estructuradas) y de embeddings
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Precios en US$ por millón de tokens, para calcular el costo por informe.
# Valores de gpt-4.1-mini y text-embedding-3-small verificados el 14/11/2026 en
# https://developers.openai.com/api/docs/pricing (no incluyen la búsqueda web: US$ 10 por mil llamadas).
PRICE_INPUT_PER_1M=0.40
PRICE_OUTPUT_PER_1M=1.60
PRICE_EMBED_PER_1M=0.02

# OPCIONAL. Sin esta clave la búsqueda web usa OpenAI (web_search) con OPENAI_API_KEY.
# Con ella usa Tavily (plan gratuito en https://app.tavily.com).
TAVILY_API_KEY=
